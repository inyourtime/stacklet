{
  "name": "stacklet",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "cf:typegen": "wrangler types",
    "check": "tsc --noEmit && pnpm lint && pnpm format:check",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:staging": "node scripts/staging-test.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file=db/schema.sql",
    "db:init:staging": "node scripts/cloudflare.mjs init staging",
    "db:init:production": "node scripts/cloudflare.mjs init production",
    "deploy:staging": "node scripts/cloudflare.mjs deploy staging",
    "deploy:production": "node scripts/cloudflare.mjs deploy production",
    "format": "oxfmt --write . && node scripts/format-sql.mjs",
    "format:check": "oxfmt --check . && node scripts/format-sql.mjs --check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.19",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "5.20261110.0-beta",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
