{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "worker-configuration.d.ts",
    "pnpm-lock.yaml",
    ".dev.vars*",
    ".env*",
    "wrangler.*.local.json",
    "**/*.sql"
  ]
}
